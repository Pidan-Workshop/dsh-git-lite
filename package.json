{
  "name": "dsh-git-lite",
  "version": "0.1.0",
  "description": "DSH Web 右侧栏的轻量 Git 面板，直接调用本机 git：改动、行内 diff、拉取、两阶段确认推送、提交、分支、stash。A lite Git tab for the DeepSeek Harness Web sidebar, driven by your local git.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node tests/host-smoke.mjs && node tests/client-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "git",
    "web"
  ],
  "author": {
    "name": "Pidan Workshop",
    "url": "https://github.com/Pidan-Workshop"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pidan-Workshop/dsh-git-lite.git"
  },
  "bugs": {
    "url": "https://github.com/Pidan-Workshop/dsh-git-lite/issues"
  },
  "homepage": "https://github.com/Pidan-Workshop/dsh-git-lite",
  "license": "MIT"
}
