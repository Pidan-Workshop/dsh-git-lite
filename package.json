{
  "name": "dsh-git-lite",
  "version": "0.2.0",
  "description": "DSH 右侧栏（Web 与桌面版）的轻量 Git 面板，直接调用本机 git：改动、行内 diff、拉取、两阶段确认推送、提交、分支、stash。A lite Git tab for the DeepSeek Harness sidebar, driven by your local git.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node tests/host-smoke.mjs && node tests/client-smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "git",
    "web",
    "desktop",
    "git-ui",
    "devtools"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    }
  },
  "author": {
    "name": "Pidan Workshop",
    "url": "https://github.com/Pidan-Workshop"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pidan-Workshop/dsh-git-lite.git"
  },
  "bugs": {
    "url": "https://github.com/Pidan-Workshop/dsh-git-lite/issues"
  },
  "homepage": "https://github.com/Pidan-Workshop/dsh-git-lite",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
